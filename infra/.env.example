# Credentials the CI pipeline needs. Copy to infra/.env, fill in, then run
# `make gh-secrets` to push them to GitHub. infra/.env is gitignored.
#
# These are the only three secrets GitHub needs. The application's own keys --
# Anthropic, Deepgram, Cartesia, LiveKit, the Django secret -- are never used by CI
# and belong in the Render dashboard instead, where Terraform is written to expect
# them. Putting them in a public repository's secret store adds exposure and buys
# nothing.

# app.terraform.io -> user settings -> tokens. Required for state access.
TF_API_TOKEN=

# Render dashboard -> account settings -> API keys.
# Not the token in ~/.render/cli.yaml: that one expires in about a month and CI
# would start failing with no obvious cause.
RENDER_API_KEY=

# Netlify -> user settings -> applications -> personal access tokens.
NETLIFY_TOKEN=
