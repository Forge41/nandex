{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(uv run:*)",
            "Bash(make:*)",
            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(git show:*)",
            "Bash(git branch:*)",
            "Bash(rg:*)",
            "Bash(ls:*)"
        ],
        "deny": [
            "Bash(git reset --hard:*)",
            "Bash(git checkout --:*)",
            "Bash(git clean:*)",
            "Bash(gh pr merge:*)",
            "Bash(ruff:*)",
            "Bash(pytest:*)",
            "Bash(pre-commit:*)",
            "Bash(pip install:*)",
            "Bash(python manage.py migrate:*)"
        ]
    }
}
