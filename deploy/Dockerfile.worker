# One Temporal worker process serving the importer, ingest and interview queues.
# Same image contents as core, different entrypoint -- the activities are the same
# Django code.

FROM python:3.13-slim

COPY --from=ghcr.io/astral-sh/uv:0.9.7 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/usr/local \
    PYTHONUNBUFFERED=1

WORKDIR /app/backend

# Read by apps.tps.catalog as parents[3]/integrations.yaml -- one level above the
# Django project, which is where it lives in the repo too.
COPY integrations.yaml /app/integrations.yaml

COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY backend/ ./

CMD ["python", "manage.py", "run_all_workers"]
