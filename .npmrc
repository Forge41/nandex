# pnpm 11 defaults this to `install`: before every `pnpm run` it diffs node_modules against
# the lockfile and, on any drift, removes and reinstalls node_modules -- prompting first.
# Under `make serve-all` there is no TTY, so the prompt aborts, `pnpm dev` exits 1, and the
# `; kill 0` behind it takes the whole stack down. `warn` still reports stale deps; it just
# never mutates node_modules or fails the run. Run `pnpm install` yourself when it warns.
verify-deps-before-run=warn
