# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=

# Database
DB_NAME=ragdb
DB_USER=ragdb
DB_PASSWORD=ragdb
DB_HOST=localhost
DB_PORT=5432

# tps — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TPS_FERNET_KEYS=
TPS_TPS_SECRET=dev-tps-secret-change-in-production
TPS_GRPC_PORT=50051

# tps — Google Drive OAuth app (console.cloud.google.com credentials)
TPS_GOOGLE_DRIVE_CLIENT_ID=
TPS_GOOGLE_DRIVE_CLIENT_SECRET=
TPS_GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/connect/google_drive/callback

# core — how core reaches tps over gRPC; must match TPS_TPS_SECRET / TPS_GRPC_PORT above
CORE_TPS_GRPC_ADDRESS=localhost:50051
CORE_TPS_SECRET=dev-tps-secret-change-in-production
