# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=

# Session/CSRF cookie security -- leave false for local HTTP dev, flip true in production
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_SESSION_COOKIE_SAMESITE=Lax
DJANGO_SESSION_COOKIE_AGE=1209600
DJANGO_CSRF_COOKIE_SECURE=false

# Real email delivery for magic links -- inert until DJANGO_EMAIL_BACKEND is switched away
# from the console default; set DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# to enable these
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Database
DB_NAME=ragdb
DB_USER=ragdb
DB_PASSWORD=ragdb
DB_HOST=localhost
DB_PORT=5432

# tps — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TPS_FERNET_KEYS=
TPS_TPS_SECRET=dev-tps-secret-change-in-production
TPS_GRPC_PORT=50051

# tps — Google Drive OAuth app (console.cloud.google.com credentials)
TPS_GOOGLE_DRIVE_CLIENT_ID=
TPS_GOOGLE_DRIVE_CLIENT_SECRET=
# Points at the backend's own OAuth callback (apps.core.api.marketplace_views.oauth_callback),
# not a frontend page -- the Next.js proxy forwards /api/* regardless of method, so the
# provider's redirect reaches this Django view directly with no frontend code needed.
TPS_GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/oauth/callback

# tps — LiveKit, the realtime room provider. tps signs every join token with these, so
# without them MintRoomToken fails and nobody can enter a room. Platform-level defaults:
# a project that connects its own LiveKit deployment overrides them per project.
# The URL is the WebSocket one the browser connects to; the SDK rewrites ws->http for
# its own server-side calls, so one value serves both.
TPS_LIVEKIT_HOST=ws://localhost:7880
TPS_LIVEKIT_API_KEY=devkey
TPS_LIVEKIT_API_SECRET=

# core — how core reaches tps over gRPC; must match TPS_TPS_SECRET / TPS_GRPC_PORT above
CORE_TPS_GRPC_ADDRESS=localhost:50051
CORE_TPS_SECRET=dev-tps-secret-change-in-production

# importer — how importer reaches tps over gRPC, and its Temporal connection
IMPORTER_TPS_GRPC_ADDRESS=localhost:50051
IMPORTER_TPS_SECRET=dev-tps-secret-change-in-production
IMPORTER_TEMPORAL_ADDRESS=localhost:7233
IMPORTER_TEMPORAL_TASK_QUEUE=importer

# ingest — pipeline_version bump forces reprocessing; embedding_dimensions must match
# whatever embedding_model_name actually outputs (see pipeline/embedders/)
INGEST_PIPELINE_VERSION=1
INGEST_EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
INGEST_EMBEDDING_DIMENSIONS=384
INGEST_CHUNK_TOKEN_BUDGET=400
INGEST_EMBED_BATCH_SIZE=64
INGEST_TEMPORAL_ADDRESS=localhost:7233
INGEST_TEMPORAL_TASK_QUEUE=ingest

# retrieval — reranker_model_name must be a fastembed TextCrossEncoder model; set
# RETRIEVAL_RERANKER_ENABLED=false to skip reranking entirely (see rerank.py's fail-open path)
RETRIEVAL_DEFAULT_TOP_K=10
RETRIEVAL_RERANKER_ENABLED=true
RETRIEVAL_RERANKER_MODEL_NAME=Xenova/ms-marco-MiniLM-L-6-v2
RETRIEVAL_MAX_CHUNKS_PER_SOURCE=3

# ai -- never read via django.conf.settings (ai/ must not import Django); required for
# chat to actually generate answers, everything else in chat works without it
AI_ANTHROPIC_API_KEY=
AI_DEFAULT_MODEL=claude-sonnet-4-5

# chat
CHAT_DEFAULT_TOP_K=8

# vas — the recording/storage service. Its own process (config.vas_asgi on :8001), the
# same database. These LiveKit keys are not a duplicate of TPS_LIVEKIT_*: Egress is itself
# a LiveKit API call, so the recorder needs a client even though tps is the only issuer of
# join tokens.
VAS_LIVEKIT_HOST=ws://localhost:7880
VAS_LIVEKIT_API_KEY=devkey
VAS_LIVEKIT_API_SECRET=
# Where finished recordings land. GCS_ENDPOINT_OVERRIDE points at fake-gcs locally and
# also switches signed URLs to direct ones, since fake-gcs has nothing to sign with.
VAS_GCS_BUCKET_NAME=local-recordings
VAS_GCS_ENDPOINT_OVERRIDE=http://localhost:4443
# Every vas endpoint except the provider webhook requires this exact bearer token. An
# empty value rejects everything rather than accepting anything, so a misconfigured
# deployment is unreachable instead of open. Must match CORE_VAS_SERVICE_BEARER_TOKEN.
VAS_SERVICE_BEARER_TOKEN=dev-vas-bearer-token
# vas signs its callbacks to core with this; must match CORE_VAS_CALLBACK_SIGNING_SECRET
# or every recording completes without core ever hearing about it.
VAS_CALLBACK_SIGNING_SECRET=dev-vas-callback-secret
# Points at the *core* process, not the frontend -- no /api prefix; that exists only in
# the Next proxy. Unset means recordings complete silently.
VAS_MAIN_BACKEND_CALLBACK_URL=http://localhost:8000/interview/callbacks/vas
VAS_TEMPORAL_ADDRESS=localhost:7233
VAS_TEMPORAL_TASK_QUEUE=vas

# core — how core reaches vas over HTTP. core is the only thing that calls vas; there is
# no browser path to it. Both secrets must match their VAS_ counterparts above.
CORE_VAS_BASE_URL=http://localhost:8001
CORE_VAS_SERVICE_BEARER_TOKEN=dev-vas-bearer-token
CORE_VAS_CALLBACK_SIGNING_SECRET=dev-vas-callback-secret

# interview — the room the candidate joins and the agent that joins with them.
# INTERVIEW_AGENT_NAME must match what the agent worker registers as, or the join token
# dispatches nobody and the candidate sits in an empty room.
INTERVIEW_AGENT_NAME=interviewer
INTERVIEW_JOIN_TOKEN_TTL_SECONDS=900
INTERVIEW_TEMPORAL_ADDRESS=localhost:7233
INTERVIEW_TEMPORAL_TASK_QUEUE=interview
# The agent has no candidate cookie, so it reads a session's brief and writes transcript
# turns with this instead. Empty rejects every agent request rather than accepting any.
INTERVIEW_AGENT_BEARER_TOKEN=dev-interview-agent-token
# Where the agent finds core. The core process, not the frontend -- no /api prefix.
INTERVIEW_CORE_BASE_URL=http://localhost:8000
# Cartesia's voice id for the interviewer.
INTERVIEW_VOICE_ID=6f84f4b8-58a2-430c-8c79-688dad597532

# The LiveKit worker reads these exact names -- they are the agent SDK's, not ours, and
# they hold the same dev pair as TPS_LIVEKIT_* above.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=

# The interviewer agent's own providers. Speech in, speech out; the LLM is the Anthropic
# key above. Without these two the agent starts and then cannot hear or answer.
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
