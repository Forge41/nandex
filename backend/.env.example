# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=

# Database
DB_NAME=ragdb
DB_USER=ragdb
DB_PASSWORD=ragdb
DB_HOST=localhost
DB_PORT=5432

# tps — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TPS_FERNET_KEYS=
TPS_TPS_SECRET=dev-tps-secret-change-in-production
TPS_GRPC_PORT=50051

# tps — Google Drive OAuth app (console.cloud.google.com credentials)
TPS_GOOGLE_DRIVE_CLIENT_ID=
TPS_GOOGLE_DRIVE_CLIENT_SECRET=
# Points at the backend's own OAuth callback (apps.core.api.marketplace_views.oauth_callback),
# not a frontend page -- the Next.js proxy forwards /api/* regardless of method, so the
# provider's redirect reaches this Django view directly with no frontend code needed.
TPS_GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/oauth/callback

# core — how core reaches tps over gRPC; must match TPS_TPS_SECRET / TPS_GRPC_PORT above
CORE_TPS_GRPC_ADDRESS=localhost:50051
CORE_TPS_SECRET=dev-tps-secret-change-in-production

# importer — how importer reaches tps over gRPC, and its Temporal connection
IMPORTER_TPS_GRPC_ADDRESS=localhost:50051
IMPORTER_TPS_SECRET=dev-tps-secret-change-in-production
IMPORTER_TEMPORAL_ADDRESS=localhost:7233
IMPORTER_TEMPORAL_TASK_QUEUE=importer

# ingest — pipeline_version bump forces reprocessing; embedding_dimensions must match
# whatever embedding_model_name actually outputs (see pipeline/embedders/)
INGEST_PIPELINE_VERSION=1
INGEST_EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
INGEST_EMBEDDING_DIMENSIONS=384
INGEST_CHUNK_TOKEN_BUDGET=400
INGEST_EMBED_BATCH_SIZE=64

# retrieval — reranker_model_name must be a fastembed TextCrossEncoder model; set
# RETRIEVAL_RERANKER_ENABLED=false to skip reranking entirely (see rerank.py's fail-open path)
RETRIEVAL_DEFAULT_TOP_K=10
RETRIEVAL_RERANKER_ENABLED=true
RETRIEVAL_RERANKER_MODEL_NAME=Xenova/ms-marco-MiniLM-L-6-v2
RETRIEVAL_MAX_CHUNKS_PER_SOURCE=3
